{
  "manifest_version": 3,
  "name": "FileLens — Visualizador de arquivos",
  "short_name": "FileLens",
  "version": "0.1.0",
  "description": "Visualize arquivos que o desktop não abre nativamente: .md, .csv, .json, .yaml, .ini, .env, .toml, .log, .xml e .txt. 100% local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir visualizador de arquivos",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "filelens@example.com",
      "strict_min_version": "121.0"
    }
  }
}
